rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAppOwner() {
      return isSignedIn() && (
        request.auth.token.email == 'justmotti@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'])
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAppOwner());
      allow list: if isAppOwner();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        isAppOwner()
      );
      allow delete: if isAppOwner();
    }

    // Global Game Access Settings
    match /settings/games {
      allow read: if true;
      allow write: if isAppOwner();
    }

    function isValidGameEvent(data) {
      return data.keys().hasAll(['gameId', 'gameTitle', 'userId', 'userName', 'startedAt', 'isGuest']) &&
             data.gameId is string && data.gameId.size() > 0 && data.gameId.size() <= 64 &&
             data.gameTitle is string && data.gameTitle.size() > 0 && data.gameTitle.size() <= 100 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
             data.startedAt is string && data.startedAt.size() <= 64 &&
             data.isGuest is bool;
    }

    // Game Start Audit Tracking
    match /gameEvents/{eventId} {
      allow read: if true;
      allow create: if isValidGameEvent(request.resource.data);
      allow update, delete: if isAppOwner();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
